#!/usr/bin/env python3

from collections import Counter, defaultdict
from pathlib import Path
import glob
import json
import os
import re
import shlex
import subprocess
import sys
import time
import uuid

WORKDIR = Path.home() / "Workspaces"
STATE = WORKDIR / ".cc-state"
PROJECTS = Path.home() / ".claude" / "projects"

# Subcommands are matched before the NAME branch, so they can never be
# session names.
LIST_COMMANDS = {"ls", "--list"}
WATCH_COMMANDS = {"watch"}
SYNC_COMMANDS = {"sync"}
STOP_COMMANDS = {"stop"}
RESERVED = LIST_COMMANDS | WATCH_COMMANDS | SYNC_COMMANDS | STOP_COMMANDS

ALL_FLAGS = {"-a", "--a", "--all"}
DETAIL_FLAGS = {"-d", "--d", "--detail"}
COLOR_FLAGS = {"-c", "--c", "--color", "--colour"}
NO_COLOR_FLAGS = {"--no-color", "--no-colour"}
YES_FLAGS = {"-y", "--yes"}

WATCH_INTERVAL = "1"


def die(message: str, code: int = 1):
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(code)


def read_state() -> list[tuple[str, str, str]]:
    # Lines are "name<TAB>kind<TAB>up|down". The third field is what the
    # session is meant to be doing, not what it is doing: this file is
    # the source of truth that sync reconciles tmux against. The second
    # field predates the third, and the first predates both, from when
    # this tool drove nothing but claude.
    if not STATE.exists():
        return []

    entries = []

    for line in STATE.read_text().splitlines():
        if not line.strip():
            continue

        fields = line.strip().split("\t")
        name = fields[0].strip()
        kind = (fields[1].strip() if len(fields) > 1 else "") or DEFAULT_KIND
        want = (fields[2].strip() if len(fields) > 2 else "") or "up"

        if kind not in AGENTS:
            die(f"unknown agent kind in {STATE.name}: {name} -> {kind}")

        if want not in ("up", "down"):
            die(f"unknown desired state in {STATE.name}: {name} -> {want}")

        entries.append((name, kind, want))

    return entries


def write_state(entries: list[tuple[str, str, str]]):
    STATE.write_text(
        "".join(f"{name}\t{kind}\t{want}\n" for name, kind, want in entries)
    )


def state_kind(entries, name: str) -> str | None:
    for entry_name, kind, _ in entries:
        if entry_name == name:
            return kind

    return None


def register(name: str, kind: str):
    entries = read_state()
    known = state_kind(entries, name)

    if known is None:
        entries.append((name, kind, "up"))
        write_state(entries)
        print(f"registered: {name} ({kind})")
        return

    if known != kind:
        # Switching kinds would resume the wrong agent under a name the
        # user already associates with another one.
        die(f"already registered as {known}: {name}")


def remove(name: str):
    entries = read_state()

    kept = [entry for entry in entries if entry[0] != name]

    if len(kept) == len(entries):
        print(f"not registered: {name}")
        return

    write_state(kept)
    print(f"removed: {name}")


def tmux_exists(name: str) -> bool:
    return subprocess.run(
        ["tmux", "has-session", "-t", f"={name}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


# Every CLI holds the alternate screen for its whole lifetime, and draws
# a marker while a turn is in flight. Reading the pane is cheaper and
# more honest than parsing session logs, whose tail reported
# "generating" for claude sessions that were plainly idle.
#
# The marker is per kind because each CLI puts it somewhere different:
# claude's is the footer line itself, while codex and gemini draw their
# input box and status bar underneath theirs. Matching the whole
# rendered form, timer included, keeps a message that merely quotes the
# words from reading as a running session.
TAIL_LINES = 10

CLAUDE_MARKER = re.compile(r"esc to interrupt")
# "auto mode on - 1 shell - 1 agent": the turn is over but a background
# shell it started has not finished, so the session is neither working
# nor free.
CLAUDE_WAIT_MARKER = re.compile(r"\b\d+ shells?\b")
CODEX_MARKER = re.compile(r"\(\d+s.{0,3}esc to interrupt\)")
GEMINI_MARKER = re.compile(r"\(esc to cancel,\s*\d+s\)")


def state_claude(lines: list[str]) -> str:
    if not lines:
        return "idle"

    footer = lines[-1]

    if CLAUDE_MARKER.search(footer):
        return "run"

    if CLAUDE_WAIT_MARKER.search(footer):
        return "wait"

    return "idle"


def state_codex(lines: list[str]) -> str:
    # "Working (5s - esc to interrupt)", third line from the bottom.
    # Startup draws the same form while booting MCP servers, which is
    # also busy, so both count.
    if any(CODEX_MARKER.search(line) for line in lines[-TAIL_LINES:]):
        return "run"

    return "idle"


def state_gemini(lines: list[str]) -> str:
    # "Finalizing Japanese Count (esc to cancel, 15s)", above the box.
    if any(GEMINI_MARKER.search(line) for line in lines[-TAIL_LINES:]):
        return "run"

    return "idle"


# Resuming means three different things. claude is told a session id it
# minted; codex is told a thread name, which amux sets with /rename
# because codex otherwise names threads after their first prompt; gemini
# is told a session id that amux mints itself, derived from the name so
# it never has to be stored anywhere.
CODEX_INDEX = Path.home() / ".codex" / "session_index.jsonl"
CODEX_READY = "Ask Codex to do anything"
CODEX_RENAMED = "Session renamed to"
CODEX_UPDATE_PROMPT = "Update available!"
CODEX_UPDATE_SKIP = "2"
# Shown after config.toml changes, because hooks run commands. Answering
# it means trusting every hook in the file, including ones an agent may
# have written, so amux only does so when told to.
CODEX_TRUST_PROMPT = "Continue without trusting"
CODEX_TRUST_ALL = "2"
CODEX_TRUST_ENV = "AMUX_TRUST_HOOKS"
CODEX_READY_TIMEOUT = 30


def gemini_session_id(name: str) -> str:
    return str(uuid.uuid5(uuid.NAMESPACE_URL, f"amux:{name}"))


def find_claude(name: str, by_name) -> str | None:
    matches = by_name.get(name, [])

    if len(matches) > 1:
        print_duplicates(name, matches)
        raise SystemExit(1)

    return matches[0].session_id if matches else None


def find_codex(name: str, by_name) -> str | None:
    # codex resume takes the thread name itself, so finding the entry is
    # only about knowing whether there is one to resume.
    if not CODEX_INDEX.exists():
        return None

    for line in CODEX_INDEX.read_text().splitlines():
        try:
            entry = json.loads(line)
        except ValueError:
            continue

        if entry.get("thread_name") == name:
            return name

    return None


def find_gemini(name: str, by_name) -> str | None:
    session_id = gemini_session_id(name)

    # gemini files a session as session-<date>-<first 8 of id>.jsonl,
    # under a per-project directory whose name it derives itself, so the
    # project directory is globbed rather than recomputed.
    pattern = str(
        Path.home()
        / ".gemini" / "tmp" / "*" / "chats"
        / f"session-*-{session_id[:8]}.json*"
    )

    return session_id if glob.glob(pattern) else None


def send_keys(name: str, *keys: str, literal: bool = False):
    flags = ["-l"] if literal else []

    subprocess.run(
        ["tmux", "send-keys", "-t", f"={name}:", *flags, *keys],
        check=True,
    )


def answer_prompt(name: str, key: str, marker: str):
    # Some of codex's dialogs act on the digit alone and some want the
    # Enter their footer asks for, so press it only if the dialog is
    # still up. Sending Enter unconditionally would answer whatever
    # dialog came next with its default.
    send_keys(name, key, literal=True)
    time.sleep(0.7)

    if marker in capture_pane(name):
        send_keys(name, "Enter")


def after_start_codex(name: str, resumed: bool) -> bool:
    # Sending keys blind would type into whatever dialog codex happens to
    # be showing, and its update prompt defaults to running an install.
    # Wait for the composer, answering only that one prompt, and only
    # with Skip, which installs nothing.
    deadline = time.monotonic() + CODEX_READY_TIMEOUT
    answered = set()

    while time.monotonic() < deadline:
        pane = capture_pane(name)

        if CODEX_READY in pane:
            break

        if CODEX_UPDATE_PROMPT in pane and "update" not in answered:
            answer_prompt(name, CODEX_UPDATE_SKIP, CODEX_UPDATE_PROMPT)
            answered.add("update")

        if CODEX_TRUST_PROMPT in pane and "trust" not in answered:
            if os.environ.get(CODEX_TRUST_ENV):
                answer_prompt(name, CODEX_TRUST_ALL, CODEX_TRUST_PROMPT)
                answered.add("trust")
            else:
                print(
                    f"WARNING: {name}: codex is asking whether to trust its"
                    f" hooks. Attach and answer it once, or set"
                    f" {CODEX_TRUST_ENV}=1 to let amux answer it."
                )
                return False

        time.sleep(0.5)
    else:
        print(f"WARNING: {name}: codex did not reach its composer")
        return False

    if resumed:
        # The thread already carries the name that found it.
        return True

    send_keys(name, f"/rename {name}", literal=True)

    # The slash-command popup is still open the instant the text lands,
    # and swallows the first Enter as a completion. Let it settle, then
    # press once more if the composer still holds the line.
    time.sleep(1.0)
    send_keys(name, "Enter")

    deadline = time.monotonic() + CODEX_READY_TIMEOUT
    retried = False

    while time.monotonic() < deadline:
        pane = capture_pane(name)

        if CODEX_RENAMED in pane:
            return True

        if not retried and f"/rename {name}" in pane:
            time.sleep(1.0)
            send_keys(name, "Enter")
            retried = True

        time.sleep(0.5)

    print(f"WARNING: {name}: /rename not confirmed, resume may not find it")
    return False


AGENTS = {
    "claude": {
        "state": state_claude,
        "find": find_claude,
        "new": lambda name: (
            f"claude --permission-mode auto --name {shlex.quote(name)}"
        ),
        "resume": lambda name, token: (
            f"claude --permission-mode auto --resume {shlex.quote(token)}"
        ),
        # Only claude keeps its sessions where the agent SDK can list
        # them, which is also the only place duplicates can arise.
        "sdk": True,
    },
    "codex": {
        "state": state_codex,
        "find": find_codex,
        "new": lambda name: "codex",
        "resume": lambda name, token: f"codex resume {shlex.quote(token)}",
        "after_start": after_start_codex,
        "sdk": False,
    },
    "gemini": {
        "state": state_gemini,
        "find": find_gemini,
        "new": lambda name: (
            f"gemini --session-id {shlex.quote(gemini_session_id(name))}"
        ),
        "resume": lambda name, token: (
            f"gemini --resume {shlex.quote(token)}"
        ),
        "sdk": False,
    },
}

DEFAULT_KIND = "claude"
KIND_FLAGS = {f"--{kind}": kind for kind in AGENTS}

CAPTURE_SEP = "<<<amux-pane-sep>>>"

RESET = "\033[0m"
COLORS = {
    "up": "\033[32m",
    "down": "\033[90m",
    "run": "\033[1;33m",
    "idle": "\033[36m",
    "wait": "\033[1;34m",
    "dead": "\033[1;31m",
    "claude": "\033[35m",
    "codex": "\033[34m",
    "gemini": "\033[32m",
    "-": "\033[90m",
    "dim": "\033[90m",
    "warn": "\033[1;31m",
}


COLOR = False


def color_enabled(force: bool | None = None) -> bool:
    # watch runs its command through a shell, so stdout is a pipe and
    # the tty test alone would drop colour under "watch -c amux ls".
    # --color says yes anyway; FORCE_COLOR/CLICOLOR_FORCE do the same
    # for commands that cannot take a flag.
    if force is not None:
        return force

    if os.environ.get("NO_COLOR"):
        return False

    if os.environ.get("FORCE_COLOR") or os.environ.get("CLICOLOR_FORCE"):
        return True

    # Piping amux ls into grep should not have to strip escapes.
    return sys.stdout.isatty()


def paint(text: str, key: str, width: int = 0) -> str:
    padded = text.ljust(width)

    if not COLOR or key is None or key not in COLORS:
        return padded

    return f"{COLORS[key]}{padded}{RESET}"


# An agent that exited leaves its shell holding the pane. Asking the
# alternate screen instead would only work for claude: codex and gemini
# never enter it, so a healthy session of either looked dead.
SHELLS = {"bash", "zsh", "sh", "fish", "dash", "ksh"}


def tmux_live() -> dict[str, bool] | None:
    # name -> whether an agent, rather than a bare shell, holds the pane.
    # None means tmux itself is not running, so nothing was observed.
    result = subprocess.run(
        [
            "tmux",
            "list-sessions",
            "-F",
            "#{session_name}\t#{pane_current_command}",
        ],
        capture_output=True,
        text=True,
    )

    if result.returncode != 0:
        return None

    live = {}

    for line in result.stdout.splitlines():
        name, _, command = line.rpartition("\t")

        if name:
            live[name] = command not in SHELLS

    return live


def capture_pane(name: str) -> str:
    result = subprocess.run(
        ["tmux", "capture-pane", "-p", "-t", f"={name}:"],
        capture_output=True,
        text=True,
    )

    return result.stdout if result.returncode == 0 else ""


def tmux_states(targets: list[tuple[str, str]]) -> dict[str, str]:
    # One tmux invocation for every pane, with a separator after each so
    # the concatenated output can be split back apart.
    if not targets:
        return {}

    names = [name for name, _ in targets]
    args = []

    for name in names:
        # "=name:" is required: a bare "name:" matches by prefix, so
        # asking for pi4-de would answer about pi4-deck.
        args += ["capture-pane", "-p", "-t", f"={name}:", ";"]
        args += ["display-message", "-p", CAPTURE_SEP, ";"]

    result = subprocess.run(
        ["tmux", *args],
        capture_output=True,
        text=True,
    )

    panes = result.stdout.split(CAPTURE_SEP)[:-1]

    if len(panes) != len(names):
        # A pane went away mid-capture; don't guess which.
        return {}

    states = {}

    for (name, kind), pane in zip(targets, panes):
        lines = [line for line in pane.splitlines() if line.strip()]

        states[name] = AGENTS[kind]["state"](lines)

    return states


def get_sessions():
    # Imported lazily: the SDK costs ~0.7s to import, which is most of
    # the runtime of commands that never touch Claude state.
    from claude_agent_sdk import list_sessions

    return list_sessions(directory=str(WORKDIR))


def group_sessions(sessions):
    result = defaultdict(list)

    for session in sessions:
        if session.custom_title:
            result[session.custom_title].append(session)

    return result


def print_duplicates(name: str, matches):
    print(
        f"ERROR: duplicate Claude sessions: {name}",
        file=sys.stderr,
    )

    for session in matches:
        print(
            f"  {session.session_id}"
            f"  last_modified={session.last_modified}",
            file=sys.stderr,
        )


def start_tmux(name: str, kind: str, token: str | None):
    agent = AGENTS[kind]

    if token is None:
        print(f"new:     {name} ({kind})")
        command = f"exec {agent['new'](name)}"
    else:
        print(f"resume:  {name} ({kind}) <- {token}")
        command = f"exec {agent['resume'](name, token)}"

    subprocess.run(
        [
            "tmux",
            "new-session",
            "-d",
            "-s", name,
            "-c", str(WORKDIR),
            command,
        ],
        check=True,
    )


def ensure(name: str, kind: str, by_name, attach: bool):
    agent = AGENTS[kind]

    if tmux_exists(name):
        print(f"exists:  {name}")

    else:
        # No session to resume is not a failure: start a fresh one under
        # the same identity so the name keeps working either way.
        token = agent["find"](name, by_name)

        start_tmux(name, kind, token)

        # Runs for a resume too: the startup dialogs that would swallow
        # keystrokes are in the way either way.
        if "after_start" in agent:
            agent["after_start"](name, resumed=token is not None)

    if attach:
        attached = subprocess.run(
            ["tmux", "attach-session", "-t", f"={name}"],
        )

        if attached.returncode != 0:
            die(f"could not attach to {name}", attached.returncode)


def restore(show_all: bool = False):
    entries = read_state()
    names = [name for name, _, _ in entries]

    duplicates = [
        name
        for name, count in Counter(names).items()
        if count > 1
    ]

    if duplicates:
        print(
            f"ERROR: duplicate names in {STATE.name}:",
            file=sys.stderr,
        )
        for name in duplicates:
            print(f"  {name}", file=sys.stderr)

        raise SystemExit(1)

    # Only what the file asks for. A name marked down is meant to stay
    # down, so starting it would be overruling the file rather than
    # applying it.
    wanted = [
        (name, kind)
        for name, kind, want in entries
        if show_all or want == "up"
    ]

    skipped = len(entries) - len(wanted)

    if skipped:
        print(f"skipped: {skipped} marked down (--all to start them)")

    resumable = [
        name for name, kind in wanted if AGENTS[kind]["sdk"]
    ]

    by_name = group_sessions(get_sessions()) if resumable else {}

    # Preflight:
    # mutate nothing until every desired role is unambiguous.
    errors = False

    for name in resumable:
        matches = by_name.get(name, [])

        if len(matches) > 1:
            errors = True

            print_duplicates(name, matches)

    if errors:
        raise SystemExit(1)

    for name, kind in wanted:
        ensure(name, kind, by_name, attach=False)


def session_path(session_id: str) -> Path:
    from claude_agent_sdk import project_key_for_directory

    return (
        PROJECTS
        / project_key_for_directory(str(WORKDIR))
        / f"{session_id}.jsonl"
    )


def rename_agent_name(session_id: str, name: str):
    # rename_session only writes custom-title, which is what
    # list_sessions matches and what the terminal title shows.
    # The prompt box reads a separate agent-name entry, so the
    # display name only follows if we append one as well.
    path = session_path(session_id)

    if not path.exists():
        die(f"session file not found: {path}")

    with path.open("a") as f:
        f.write(
            json.dumps(
                {
                    "type": "agent-name",
                    "agentName": name,
                    "sessionId": session_id,
                },
                separators=(",", ":"),
            )
            + "\n"
        )


def rename(old: str, new: str):
    entries = read_state()
    names = [name for name, _, _ in entries]

    # Preflight:
    # refuse anything ambiguous before touching tmux,
    # Claude, or .cc-state.
    if old == new:
        die(f"same name: {old}")

    if old not in names:
        die(f"not registered: {old}")

    kind = state_kind(entries, old)

    if kind != "claude":
        # Renaming rewrites claude's stored title and agent-name entry.
        # The other CLIs keep their own session records and would need
        # their own implementation rather than a silent no-op.
        die(f"rename is claude-only, {old} is {kind}")

    if new in names:
        die(f"already registered: {new}")

    if new in RESERVED:
        die(f"reserved name: {new}")

    if tmux_exists(new):
        die(f"tmux session already exists: {new}")

    sessions = get_sessions()
    by_name = group_sessions(sessions)

    if by_name.get(new):
        die(f"Claude session already titled: {new}")

    matches = by_name.get(old, [])

    if len(matches) > 1:
        print_duplicates(old, matches)
        raise SystemExit(1)

    if not matches:
        die(f"no Claude session: {old}")

    from claude_agent_sdk import rename_session

    session = matches[0]

    rename_session(
        session.session_id,
        new,
        directory=str(WORKDIR),
    )
    rename_agent_name(session.session_id, new)
    print(f"claude:  {session.session_id} -> {new}")

    if tmux_exists(old):
        subprocess.run(
            ["tmux", "rename-session", "-t", f"={old}", new],
            check=True,
        )
        print(f"tmux:    {old} -> {new}")

    write_state([
        (new if name == old else name, entry_kind, want)
        for name, entry_kind, want in entries
    ])
    print(f"state:   {old} -> {new}")


def describe(name: str, kind: str, by_name) -> str:
    if kind == "claude":
        matches = by_name.get(name, [])

        if len(matches) > 1:
            return f"duplicate ({len(matches)} sessions)"

        return matches[0].session_id if matches else "-"

    if kind == "gemini":
        # Derived from the name, so show it even before the first run
        # rather than pretending there is nothing to resume into.
        found = AGENTS[kind]["find"](name, by_name)

        return gemini_session_id(name) if found else "-"

    return AGENTS[kind]["find"](name, by_name) or "-"


def list_names(show_all: bool, detail: bool):
    entries = read_state()

    if not entries:
        print("no registered names")
        return

    # tmux ls sorts by session name, so do the same here
    # rather than exposing the state file's registration order.
    live = tmux_live()

    # Read-only: the file says what should be running, and listing is
    # not a statement of intent.
    entries = sorted(entries)

    seen = live or {}
    states = tmux_states(
        [(name, kind) for name, kind, _ in entries if seen.get(name)]
    )

    def columns(name: str) -> tuple[str, str]:
        # tmux column: does the session exist at all.
        # agent column: what the CLI inside it is doing.
        if name not in seen:
            return "down", "-"

        if not seen[name]:
            # tmux session outlived the agent that was running in it.
            return "up", "dead"

        return "up", states.get(name, "idle")

    rows = [(name, kind, *columns(name)) for name, kind, _ in entries]

    if not show_all:
        rows = [row for row in rows if row[2] != "down"]

    if not rows:
        print("no live sessions (use --all to see down ones)")
        return

    # The session id only matters when you are about to act on it, so
    # the default listing skips the lookup entirely. It is claude's
    # record, so rows of another kind have nothing to show.
    by_name = group_sessions(get_sessions()) if detail else None

    width = max(len(name) for name, _, _, _ in rows)
    kind_width = max(len(kind) for _, kind, _, _ in rows)

    for name, kind, tmux, state in rows:
        cells = [(name, None), (kind, kind), (tmux, tmux), (state, state)]

        if by_name is not None:
            described = describe(name, kind, by_name)
            cells.append((
                described,
                "warn" if described.startswith("duplicate") else "dim",
            ))

        widths = [width, kind_width, 4, 4, 0]

        print("  ".join(
            # The last cell is not padded, so nothing trails the line.
            paint(text, key, 0 if index == len(cells) - 1 else widths[index])
            for index, (text, key) in enumerate(cells)
        ))


def kill_tmux(name: str):
    subprocess.run(
        ["tmux", "kill-session", "-t", f"={name}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def sync(assume_yes: bool):
    entries = read_state()
    live = tmux_live()

    if live is None:
        die("tmux is not running, so there is nothing to reconcile")

    declared = {name for name, _, _ in entries}

    to_start = [
        (name, kind)
        for name, kind, want in entries
        if want == "up" and name not in live
    ]
    to_stop = [
        name
        for name, _, want in entries
        if want == "down" and name in live
    ]
    # Sessions nobody declared are left alone. amux drives what the file
    # names and nothing else.
    untracked = sorted(name for name in live if name not in declared)

    for name, kind in to_start:
        print(f"start:   {name} ({kind})")

    for name in to_stop:
        print(f"stop:    {name}")

    if untracked:
        # One line, not one per session: on this machine the undeclared
        # ones outnumber the declared ones and would bury the plan.
        print(f"ignored: {len(untracked)} not in {STATE.name}")

    if not to_start and not to_stop:
        print("in sync")
        return

    if to_stop and not assume_yes:
        # Killing a session takes its scrollback with it, so say what
        # will happen before doing it.
        if not sys.stdin.isatty():
            die("refusing to stop sessions without a tty; pass --yes")

        answer = input(f"stop {len(to_stop)} session(s)? [y/N] ")

        if answer.strip().lower() not in ("y", "yes"):
            print("aborted")
            return

    for name in to_stop:
        kill_tmux(name)
        print(f"stopped: {name}")

    if to_start:
        resumable = [
            name for name, kind in to_start if AGENTS[kind]["sdk"]
        ]
        by_name = group_sessions(get_sessions()) if resumable else {}

        for name, kind in to_start:
            ensure(name, kind, by_name, attach=False)


def stop(name: str):
    entries = read_state()

    if name not in {entry[0] for entry in entries}:
        die(f"not registered: {name}")

    write_state([
        (entry_name, kind, "down" if entry_name == name else want)
        for entry_name, kind, want in entries
    ])
    print(f"state:   {name} -> down")

    if tmux_exists(name):
        kill_tmux(name)
        print(f"stopped: {name}")


def watch(rest: list[str]):
    # watch joins its trailing arguments and hands them to a shell, so
    # the path is quoted rather than trusted to be free of spaces.
    command = " ".join(
        shlex.quote(part)
        for part in [str(Path(__file__).resolve()), "ls", "--color", *rest]
    )

    # exec, so ctrl-c reaches watch itself and not a wrapper around it.
    os.execvp(
        "watch",
        ["watch", "-c", "-n", WATCH_INTERVAL, "-t", command],
    )


def usage():
    print(
        f"""usage:
  {sys.argv[0]} [--claude|--codex|--gemini] NAME
  {sys.argv[0]} sync [--yes]
  {sys.argv[0]} stop NAME
  {sys.argv[0]} --restore [--all]
  {sys.argv[0]} ls [--all] [--detail] [--color|--no-color]
  {sys.argv[0]} watch [--all] [--detail]
  {sys.argv[0]} --rm NAME
  {sys.argv[0]} --rename OLD NEW
""",
        file=sys.stderr,
    )


def main():
    global COLOR

    COLOR = color_enabled()

    args = sys.argv[1:]

    if args and args[0] in SYNC_COMMANDS:
        rest = args[1:]

        if all(arg in YES_FLAGS for arg in rest):
            sync(assume_yes=bool(rest))
            return

        usage()
        raise SystemExit(2)

    if len(args) == 2 and args[0] in STOP_COMMANDS:
        stop(args[1])
        return

    if args and args[0] in WATCH_COMMANDS:
        rest = args[1:]

        if all(arg in ALL_FLAGS | DETAIL_FLAGS for arg in rest):
            watch(rest)
            return

        usage()
        raise SystemExit(2)

    if args and args[0] in LIST_COMMANDS:
        rest = args[1:]
        known = ALL_FLAGS | DETAIL_FLAGS | COLOR_FLAGS | NO_COLOR_FLAGS

        if all(arg in known for arg in rest):
            force = None

            if any(arg in COLOR_FLAGS for arg in rest):
                force = True

            if any(arg in NO_COLOR_FLAGS for arg in rest):
                force = False

            COLOR = color_enabled(force)

            list_names(
                show_all=any(arg in ALL_FLAGS for arg in rest),
                detail=any(arg in DETAIL_FLAGS for arg in rest),
            )
            return

        usage()
        raise SystemExit(2)

    if args and args[0] == "--restore":
        rest = args[1:]

        if all(arg in ALL_FLAGS for arg in rest):
            restore(show_all=bool(rest))
            return

        usage()
        raise SystemExit(2)

    if len(args) == 3 and args[0] == "--rename":
        rename(args[1], args[2])
        return

    if len(args) == 2 and args[0] == "--rm":
        remove(args[1])
        return

    # "amux NAME --codex" and "amux --codex NAME" are the same request,
    # so the flag is read from wherever it lands.
    flags = [arg for arg in args if arg.startswith("-")]
    names = [arg for arg in args if not arg.startswith("-")]

    if len(names) == 1 and all(flag in KIND_FLAGS for flag in flags):
        name = names[0]
        asked = {KIND_FLAGS[flag] for flag in flags}

        if len(asked) > 1:
            die(f"conflicting agent flags: {' '.join(sorted(asked))}")

        # An already registered name keeps its kind, so attaching to it
        # never needs the flag repeated.
        kind = state_kind(read_state(), name)

        if asked:
            kind = asked.pop()
        elif kind is None:
            kind = DEFAULT_KIND

        by_name = {}

        if AGENTS[kind]["sdk"]:
            by_name = group_sessions(get_sessions())

            # Check before registering, so ambiguous Claude state
            # doesn't modify desired state.
            matches = by_name.get(name, [])

            if len(matches) > 1:
                print_duplicates(name, matches)
                raise SystemExit(1)

        register(name, kind)
        ensure(name, kind, by_name, attach=True)
        return

    usage()
    raise SystemExit(2)


if __name__ == "__main__":
    main()
