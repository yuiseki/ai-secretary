#!/usr/bin/env python3

from collections import Counter, defaultdict
from pathlib import Path
import json
import os
import shlex
import subprocess
import sys

WORKDIR = Path.home() / "Workspaces"
STATE = WORKDIR / ".cc-state"
PROJECTS = Path.home() / ".claude" / "projects"

# Subcommands are matched before the NAME branch, so they can never be
# session names.
LIST_COMMANDS = {"ls", "--list"}
WATCH_COMMANDS = {"watch"}
RESERVED = LIST_COMMANDS | WATCH_COMMANDS

ALL_FLAGS = {"-a", "--a", "--all"}
DETAIL_FLAGS = {"-d", "--d", "--detail"}
COLOR_FLAGS = {"-c", "--c", "--color", "--colour"}
NO_COLOR_FLAGS = {"--no-color", "--no-colour"}

WATCH_INTERVAL = "1"


def die(message: str, code: int = 1):
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(code)


def read_state() -> list[str]:
    if not STATE.exists():
        return []

    return [
        line.strip()
        for line in STATE.read_text().splitlines()
        if line.strip()
    ]


def write_state(names: list[str]):
    STATE.write_text(
        "".join(f"{name}\n" for name in names)
    )


def register(name: str):
    names = read_state()

    if name not in names:
        names.append(name)
        write_state(names)
        print(f"registered: {name}")


def remove(name: str):
    names = read_state()

    new_names = [n for n in names if n != name]

    if len(new_names) == len(names):
        print(f"not registered: {name}")
        return

    write_state(new_names)
    print(f"removed: {name}")


def tmux_exists(name: str) -> bool:
    return subprocess.run(
        ["tmux", "has-session", "-t", f"={name}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


# Claude Code holds the alternate screen for its whole lifetime, and
# puts "esc to interrupt" in its footer only while a turn is in flight.
# Both are cheaper and more honest than parsing the session jsonl, whose
# tail reports "generating" for sessions that are plainly idle.
RUNNING_MARKER = "esc to interrupt"
CAPTURE_SEP = "<<<amux-pane-sep>>>"

RESET = "\033[0m"
COLORS = {
    "up": "\033[32m",
    "down": "\033[90m",
    "run": "\033[1;33m",
    "idle": "\033[36m",
    "dead": "\033[1;31m",
    "-": "\033[90m",
    "dim": "\033[90m",
    "warn": "\033[1;31m",
}


COLOR = False


def color_enabled(force: bool | None = None) -> bool:
    # watch runs its command through a shell, so stdout is a pipe and
    # the tty test alone would drop colour under "watch -c amux ls".
    # --color says yes anyway; FORCE_COLOR/CLICOLOR_FORCE do the same
    # for commands that cannot take a flag.
    if force is not None:
        return force

    if os.environ.get("NO_COLOR"):
        return False

    if os.environ.get("FORCE_COLOR") or os.environ.get("CLICOLOR_FORCE"):
        return True

    # Piping amux ls into grep should not have to strip escapes.
    return sys.stdout.isatty()


def paint(text: str, key: str, width: int = 0) -> str:
    padded = text.ljust(width)

    if not COLOR or key is None or key not in COLORS:
        return padded

    return f"{COLORS[key]}{padded}{RESET}"


def tmux_live() -> dict[str, bool]:
    # name -> whether Claude still owns the pane (alternate screen on).
    result = subprocess.run(
        ["tmux", "list-sessions", "-F", "#{session_name}\t#{alternate_on}"],
        capture_output=True,
        text=True,
    )

    if result.returncode != 0:
        return {}

    live = {}

    for line in result.stdout.splitlines():
        name, _, alternate = line.rpartition("\t")

        if name:
            live[name] = alternate == "1"

    return live


def tmux_running(names: list[str]) -> dict[str, bool]:
    # One tmux invocation for every pane, with a separator after each so
    # the concatenated output can be split back apart.
    if not names:
        return {}

    args = []

    for name in names:
        # "=name:" is required: a bare "name:" matches by prefix, so
        # asking for pi4-de would answer about pi4-deck.
        args += ["capture-pane", "-p", "-t", f"={name}:", ";"]
        args += ["display-message", "-p", CAPTURE_SEP, ";"]

    result = subprocess.run(
        ["tmux", *args],
        capture_output=True,
        text=True,
    )

    panes = result.stdout.split(CAPTURE_SEP)[:-1]

    if len(panes) != len(names):
        # A pane went away mid-capture; don't guess which.
        return {}

    running = {}

    for name, pane in zip(names, panes):
        lines = [line for line in pane.splitlines() if line.strip()]

        # Only the footer counts. A message quoting the marker would
        # otherwise read as a running session.
        running[name] = bool(lines) and RUNNING_MARKER in lines[-1]

    return running


def get_sessions():
    # Imported lazily: the SDK costs ~0.7s to import, which is most of
    # the runtime of commands that never touch Claude state.
    from claude_agent_sdk import list_sessions

    return list_sessions(directory=str(WORKDIR))


def group_sessions(sessions):
    result = defaultdict(list)

    for session in sessions:
        if session.custom_title:
            result[session.custom_title].append(session)

    return result


def print_duplicates(name: str, matches):
    print(
        f"ERROR: duplicate Claude sessions: {name}",
        file=sys.stderr,
    )

    for session in matches:
        print(
            f"  {session.session_id}"
            f"  last_modified={session.last_modified}",
            file=sys.stderr,
        )


def start_tmux(name: str, session=None):
    if session is None:
        print(f"new:     {name}")

        command = (
            "exec claude "
            "--permission-mode auto "
            f"--name {shlex.quote(name)}"
        )
    else:
        print(f"resume:  {name} <- {session.session_id}")

        command = (
            "exec claude "
            "--permission-mode auto "
            f"--resume {shlex.quote(session.session_id)}"
        )

    subprocess.run(
        [
            "tmux",
            "new-session",
            "-d",
            "-s", name,
            "-c", str(WORKDIR),
            command,
        ],
        check=True,
    )


def ensure(name: str, by_name, attach: bool):
    matches = by_name.get(name, [])

    if len(matches) > 1:
        print_duplicates(name, matches)
        raise SystemExit(1)

    if tmux_exists(name):
        print(f"exists:  {name}")

    elif len(matches) == 1:
        start_tmux(name, matches[0])

    else:
        start_tmux(name)

    if attach:
        subprocess.run(
            ["tmux", "attach-session", "-t", f"={name}"],
            check=True,
        )


def restore():
    names = read_state()

    duplicates = [
        name
        for name, count in Counter(names).items()
        if count > 1
    ]

    if duplicates:
        print(
            "ERROR: duplicate names in .cc-state:",
            file=sys.stderr,
        )
        for name in duplicates:
            print(f"  {name}", file=sys.stderr)

        raise SystemExit(1)

    sessions = get_sessions()
    by_name = group_sessions(sessions)

    # Preflight:
    # mutate nothing until every desired role is unambiguous.
    errors = False

    for name in names:
        matches = by_name.get(name, [])

        if len(matches) > 1:
            errors = True

            print_duplicates(name, matches)

    if errors:
        raise SystemExit(1)

    for name in names:
        ensure(name, by_name, attach=False)


def session_path(session_id: str) -> Path:
    from claude_agent_sdk import project_key_for_directory

    return (
        PROJECTS
        / project_key_for_directory(str(WORKDIR))
        / f"{session_id}.jsonl"
    )


def rename_agent_name(session_id: str, name: str):
    # rename_session only writes custom-title, which is what
    # list_sessions matches and what the terminal title shows.
    # The prompt box reads a separate agent-name entry, so the
    # display name only follows if we append one as well.
    path = session_path(session_id)

    if not path.exists():
        die(f"session file not found: {path}")

    with path.open("a") as f:
        f.write(
            json.dumps(
                {
                    "type": "agent-name",
                    "agentName": name,
                    "sessionId": session_id,
                },
                separators=(",", ":"),
            )
            + "\n"
        )


def rename(old: str, new: str):
    names = read_state()

    # Preflight:
    # refuse anything ambiguous before touching tmux,
    # Claude, or .cc-state.
    if old == new:
        die(f"same name: {old}")

    if old not in names:
        die(f"not registered: {old}")

    if new in names:
        die(f"already registered: {new}")

    if new in RESERVED:
        die(f"reserved name: {new}")

    if tmux_exists(new):
        die(f"tmux session already exists: {new}")

    sessions = get_sessions()
    by_name = group_sessions(sessions)

    if by_name.get(new):
        die(f"Claude session already titled: {new}")

    matches = by_name.get(old, [])

    if len(matches) > 1:
        print_duplicates(old, matches)
        raise SystemExit(1)

    if not matches:
        die(f"no Claude session: {old}")

    from claude_agent_sdk import rename_session

    session = matches[0]

    rename_session(
        session.session_id,
        new,
        directory=str(WORKDIR),
    )
    rename_agent_name(session.session_id, new)
    print(f"claude:  {session.session_id} -> {new}")

    if tmux_exists(old):
        subprocess.run(
            ["tmux", "rename-session", "-t", f"={old}", new],
            check=True,
        )
        print(f"tmux:    {old} -> {new}")

    write_state([new if n == old else n for n in names])
    print(f"state:   {old} -> {new}")


def describe(name: str, by_name) -> str:
    matches = by_name.get(name, [])

    if len(matches) > 1:
        return f"duplicate ({len(matches)} sessions)"

    if len(matches) == 1:
        return matches[0].session_id

    return "-"


def list_names(show_all: bool, detail: bool):
    names = read_state()

    if not names:
        print("no registered names")
        return

    # tmux ls sorts by session name, so do the same here
    # rather than exposing .cc-state's registration order.
    names = sorted(names)

    live = tmux_live()
    running = tmux_running(
        [name for name in names if live.get(name)]
    )

    def columns(name: str) -> tuple[str, str]:
        # tmux column: does the session exist at all.
        # claude column: what the agent inside it is doing.
        if name not in live:
            return "down", "-"

        if not live[name]:
            # tmux session outlived the Claude process in it.
            return "up", "dead"

        return "up", "run" if running.get(name) else "idle"

    rows = [(name, *columns(name)) for name in names]

    if not show_all:
        rows = [row for row in rows if row[1] != "down"]

    if not rows:
        print("no live sessions (use --all to see down ones)")
        return

    # The session id only matters when you are about to act on it,
    # so the default listing skips the lookup entirely.
    by_name = group_sessions(get_sessions()) if detail else None

    width = max(len(name) for name, _, _ in rows)

    for name, tmux, state in rows:
        cells = [(name, None), (tmux, tmux), (state, state)]

        if by_name is not None:
            described = describe(name, by_name)
            cells.append((
                described,
                "warn" if described.startswith("duplicate") else "dim",
            ))

        widths = [width, 4, 4, 0]

        print("  ".join(
            # The last cell is not padded, so nothing trails the line.
            paint(text, key, 0 if index == len(cells) - 1 else widths[index])
            for index, (text, key) in enumerate(cells)
        ))


def watch(rest: list[str]):
    # watch joins its trailing arguments and hands them to a shell, so
    # the path is quoted rather than trusted to be free of spaces.
    command = " ".join(
        shlex.quote(part)
        for part in [str(Path(__file__).resolve()), "ls", "--color", *rest]
    )

    # exec, so ctrl-c reaches watch itself and not a wrapper around it.
    os.execvp(
        "watch",
        ["watch", "-c", "-n", WATCH_INTERVAL, "-t", command],
    )


def usage():
    print(
        f"""usage:
  {sys.argv[0]} NAME
  {sys.argv[0]} --restore
  {sys.argv[0]} ls [--all] [--detail] [--color|--no-color]
  {sys.argv[0]} watch [--all] [--detail]
  {sys.argv[0]} --rm NAME
  {sys.argv[0]} --rename OLD NEW
""",
        file=sys.stderr,
    )


def main():
    global COLOR

    COLOR = color_enabled()

    args = sys.argv[1:]

    if args and args[0] in WATCH_COMMANDS:
        rest = args[1:]

        if all(arg in ALL_FLAGS | DETAIL_FLAGS for arg in rest):
            watch(rest)
            return

        usage()
        raise SystemExit(2)

    if args and args[0] in LIST_COMMANDS:
        rest = args[1:]
        known = ALL_FLAGS | DETAIL_FLAGS | COLOR_FLAGS | NO_COLOR_FLAGS

        if all(arg in known for arg in rest):
            force = None

            if any(arg in COLOR_FLAGS for arg in rest):
                force = True

            if any(arg in NO_COLOR_FLAGS for arg in rest):
                force = False

            COLOR = color_enabled(force)

            list_names(
                show_all=any(arg in ALL_FLAGS for arg in rest),
                detail=any(arg in DETAIL_FLAGS for arg in rest),
            )
            return

        usage()
        raise SystemExit(2)

    if len(args) == 1 and args[0] == "--restore":
        restore()
        return

    if len(args) == 3 and args[0] == "--rename":
        rename(args[1], args[2])
        return

    if len(args) == 2 and args[0] == "--rm":
        remove(args[1])
        return

    if len(args) == 1 and not args[0].startswith("-"):
        name = args[0]

        sessions = get_sessions()
        by_name = group_sessions(sessions)

        # Check before registering, so ambiguous Claude state
        # doesn't modify desired state.
        matches = by_name.get(name, [])

        if len(matches) > 1:
            print_duplicates(name, matches)
            raise SystemExit(1)

        register(name)
        ensure(name, by_name, attach=True)
        return

    usage()
    raise SystemExit(2)


if __name__ == "__main__":
    main()
